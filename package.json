{
  "name": "applypilot",
  "version": "0.1.0",
  "private": true,
  "description": "ApplyPilot monorepo workspace",
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:desktop": "npm --workspace=@applypilot/desktop run dev",
    "build:desktop": "npm --workspace=@applypilot/desktop run build",
    "typecheck:desktop": "npm --workspace=@applypilot/desktop run typecheck",
    "typecheck:ui": "tsc -p packages/ui/tsconfig.json --noEmit",
    "typecheck": "npm run typecheck:ui && npm run typecheck:desktop",
    "test:database": "npm --workspace=@applypilot/desktop run test:database",
    "test:storage-foundation": "npm --workspace=@applypilot/desktop run test:storage-foundation",
    "test:storage-path": "npm --workspace=@applypilot/desktop run test:storage-path",
    "test:clean-storage-profile": "npm --workspace=@applypilot/desktop run test:clean-storage-profile",
    "test:final-storage-job-architecture": "npm --workspace=@applypilot/desktop run test:final-storage-job-architecture",
    "test:complete-profile-schema": "npm --workspace=@applypilot/desktop run test:complete-profile-schema",
    "test:connectors": "npm --workspace=@applypilot/desktop run test:connectors"
  },
  "devDependencies": {
    "typescript": "^5.8.2"
  },
  "engines": {
    "node": ">=20.0.0",
    "npm": ">=10.0.0"
  }
}
