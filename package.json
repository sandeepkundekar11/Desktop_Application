{
  "name": "applypilot",
  "version": "0.1.0",
  "private": true,
  "description": "ApplyPilot monorepo workspace",
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:desktop": "npm --workspace=@applypilot/desktop run dev",
    "build:desktop": "npm --workspace=@applypilot/desktop run build",
    "typecheck:desktop": "npm --workspace=@applypilot/desktop run typecheck",
    "typecheck:ui": "tsc -p packages/ui/tsconfig.json --noEmit",
    "typecheck": "npm run typecheck:ui && npm run typecheck:desktop"
  },
  "devDependencies": {
    "typescript": "^5.8.2"
  },
  "engines": {
    "node": ">=20.0.0",
    "npm": ">=10.0.0"
  }
}
