{
  "name": "@applypilot/desktop",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "dist-electron/main/main.js",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "npm run build:electron && npm run build:renderer",
    "build:electron": "tsc -p tsconfig.node.json",
    "build:renderer": "vite build",
    "typecheck": "tsc -p tsconfig.node.json --noEmit && tsc -p tsconfig.web.json --noEmit",
    "test:database": "electron scripts/test-database.mjs",
    "test:storage-foundation": "electron scripts/test-storage-foundation.mjs",
    "test:storage-path": "electron scripts/test-storage-path-strategy.mjs",
    "test:clean-storage-profile": "electron scripts/test-clean-storage-profile.mjs",
    "test:final-storage-job-architecture": "electron scripts/test-final-storage-job-architecture.mjs",
    "test:complete-profile-schema": "electron scripts/test-complete-profile-schema.mjs",
    "test:minimal-foundation": "electron scripts/test-minimal-profile-foundation.mjs",
    "test:replace-resume-flow": "electron scripts/test-replace-resume-flow.mjs",
    "test:connectors": "electron scripts/test-connector-persistence.mjs",
    "start": "electron ."
  },
  "dependencies": {
    "@applypilot/ui": "*",
    "mammoth": "^1.13.0",
    "pdf-parse": "^2.4.5",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/pdf-parse": "^1.1.5",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^35.0.0",
    "vite": "^6.2.0"
  }
}